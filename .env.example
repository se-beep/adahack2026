# Copy this file to .env and fill it in to send real sign-up codes by email.
# Without it the app runs in dev mode: codes are printed in the server log and
# shown on the page instead of being emailed.
#
# Any SMTP provider works. Gmail example: turn on 2-step verification, create an
# "app password" at https://myaccount.google.com/apppasswords and use it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="LifeLine <you@gmail.com>"
